# Python Virtual Environment
venv/
__pycache__/

# Data Folders (Never commit raw data or DB dumps)
data/raw/*
data/processed/*
data/reports/*

# Keep the directory structure, but ignore the files inside
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/reports/.gitkeep

# Environment variables (If you add API keys later)
.env

# Working notes. README.md is the only markdown that belongs to the project;
# anything else dropped in the repo root is scratch and must not be committed.
# Scoped to the root on purpose -- real docs under docs/ stay tracked.
/*.md
!/README.md

# Airflow runtime output, generated per run and per container.
# config/airflow.cfg holds a generated fernet_key and secret_key -- the fernet
# key decrypts every stored Airflow connection, so it must never be committed.
logs/
plugins/
config/airflow.cfg
